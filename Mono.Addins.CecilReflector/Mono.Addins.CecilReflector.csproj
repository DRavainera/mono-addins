<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Mono.Addins.CecilReflector</AssemblyName>
    <RootNamespace>Mono.Addins.CecilReflector</RootNamespace>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <ImplicitUsings>false</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <SignAssembly>false</SignAssembly>
    <NoWarn>$(NoWarn);1591;1574</NoWarn>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <OutputPath>bin\</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <!-- 2026-10-12: Mono.Cecil 0.11.6 (netstandard2.0, primera clase en .NET 10) en
         lugar del 0.10.1 net40 vendurado en la cache (binario de 2018). Es la linea
         0.11 continua no-rompida de la 0.10 y es la version contra la que se
         estagia main/build/ para que el runtime y el build usen la misma. -->
    <PackageReference Include="Mono.Cecil" Version="0.11.6" />
    <ProjectReference Include="..\Mono.Addins\Mono.Addins.csproj" />
  </ItemGroup>
</Project>
