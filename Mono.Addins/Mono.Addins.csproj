<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net461;net472;net8.0</TargetFrameworks>
    <AssemblyName>Mono.Addins</AssemblyName>
    <RootNamespace>Mono.Addins</RootNamespace>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <ImplicitUsings>false</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <SignAssembly>false</SignAssembly>
    <NoWarn>$(NoWarn);1591;1574</NoWarn>
    <OutputPath>bin\</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="CustomConditionAttribute.cs" />
  </ItemGroup>
</Project>
